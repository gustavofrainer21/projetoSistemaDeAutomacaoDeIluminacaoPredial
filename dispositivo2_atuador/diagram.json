{
  "version": 1,
  "author": "Grupo ODS 7",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-relay-module", "id": "relay1", "top": 60, "left": -220, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -90, "left": -200, "attrs": { "color": "yellow" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -30, "left": -200, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "relay1:VCC", "esp:5V", "red", [ "h0" ] ],
    [ "relay1:GND", "esp:GND.1", "black", [ "h0" ] ],
    [ "relay1:IN", "esp:26", "green", [ "h0" ] ],
    [ "relay1:COM", "esp:3V3", "red", [ "h0" ] ],
    [ "relay1:NO", "r1:1", "orange", [ "h0" ] ],
    [ "r1:2", "led1:A", "orange", [ "h0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "h0" ] ]
  ],
  "dependencies": {}
}
