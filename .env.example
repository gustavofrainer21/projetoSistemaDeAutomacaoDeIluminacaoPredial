# Copie para .env (NAO versionar o .env). Todos os valores abaixo sao FICTICIOS.
# Variaveis lidas pelo Node-RED (defina no sistema antes de iniciar o Node-RED)
OPENWEATHER_KEY=SUA_CHAVE_OPENWEATHER
OPENWEATHER_CITY=Sao Paulo,BR

# Configuradas no editor do Node-RED (no de configuracao do InfluxDB), nunca no repositorio
# INFLUX_URL=https://REGIAO.aws.cloud2.influxdata.com
# INFLUX_ORG=SUA_ORGANIZACAO
# INFLUX_BUCKET=iluminacao
# INFLUX_TOKEN=TOKEN_DE_ESCRITA_FICTICIO
